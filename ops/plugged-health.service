[Unit]
Description=Plugged external HTTPS availability probe
After=network-online.target

[Service]
Type=oneshot
User=plugged
Group=plugged
WorkingDirectory=/opt/plugged/current
EnvironmentFile=/etc/plugged/service.env
ExecStart=/opt/bun/bin/bun --no-env-file --no-install tools/operations-health.mjs
TimeoutStartSec=25
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# Bun's JIT needs writable+executable memory: MemoryDenyWriteExecute must stay off.
MemoryMax=256M
TasksMax=32
