[Unit]
Description=Plugged consistent SQLite backup and restore drill
After=plugged.service

[Service]
Type=oneshot
User=plugged
Group=plugged
WorkingDirectory=/opt/plugged/current
EnvironmentFile=/etc/plugged/service.env
ExecStart=/opt/bun/bin/bun --no-env-file --no-install tools/operations-backup-job.mjs
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plugged /var/backups/plugged
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# Bun's JIT needs writable+executable memory: MemoryDenyWriteExecute must stay off.
MemoryMax=512M
TasksMax=64
