# Copy outside the release to /etc/plugged/secrets.env, owned root:root, mode 0600.
# systemd reads this as root before changing user. Do not commit populated copies.
# Set the operator's HTTPS RPC endpoint; URL/API credentials belong only here.
PLUGGED_RPC_URL=
# Optional integration; leave blank unless configured.
BAGS_API_KEY=
# NEVER put a wallet private key, mnemonic, seed phrase or keystore password here.
