# Copy outside the release to /etc/plugged/service.env, owned root:plugged, mode 0640.
NODE_ENV=production
PORT=4317
PLUGGED_DB_PATH=/var/lib/plugged/launches.sqlite
PLUGGED_BACKUP_DIR=/var/backups/plugged
# Configure a real domain. Preflight intentionally rejects this placeholder.
PLUGGED_PUBLIC_ORIGIN=https://plugged.example.invalid
# Keep signing disabled until host, contract configuration and launch flow are verified.
PLUGGED_LAUNCH_ENABLED=false
