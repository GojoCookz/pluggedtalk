# Server only. Never put these values in frontend code or commit a populated .env.
BAGS_API_KEY=
# Optional persistent HMAC secret (at least 32 random bytes) for identity-resolution receipts.
# This is not a wallet private key. The HTTP server never needs a wallet signer.
# Without it, a random process-local key invalidates old receipts on server restart.
PLUGGED_SOCIAL_RECEIPT_SECRET=
PORT=4317
# Enable Carbon-backed wallet signing after deployment verification.
PLUGGED_LAUNCH_ENABLED=false
# Verified plugged-advanced-v1 deployment profile (runtime/*.json). Empty keeps advanced launch unavailable.
PLUGGED_ADVANCED_PROFILE=
# Server-only Pinata JWT with file-pinning permission. Blank disables uploads.
PLUGGED_PINATA_JWT=
# Trusted public HTTPS origin behind a reverse proxy. Forwarded Host is never trusted.
# Blank permits same-Host local preview requests; set the exact origin in production.
PLUGGED_PUBLIC_ORIGIN=
# Dedicated Robinhood RPC and durable SQLite path. Production paths belong outside release.
# Backup captures launch, trading, rewards and default program tables using VACUUM INTO.
PLUGGED_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PLUGGED_DB_PATH=./runtime/launches.sqlite
# Independent campaign/cashback signing gate. Reads and receipt recovery remain available.
PLUGGED_PROGRAMS_ENABLED=false
# Trusted operator manifest; blank means no deployed programs, not sample deployments.
PLUGGED_PROGRAMS_MANIFEST=
# Optional separate program DB. Blank shares PLUGGED_DB_PATH. Separate DB needs its own backup.
PLUGGED_PROGRAMS_DB_PATH=
# Existing private absolute directory for the operations backup job.
PLUGGED_BACKUP_DIR=
# Validated runtime: Bun 1.3.9. Production templates disable automatic dotenv loading.
# Callouts in the Advanced tab: open | premoderated | readonly | off (default open).
PLUGGED_CALLOUTS=
